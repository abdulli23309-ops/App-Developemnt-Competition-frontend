# CampusConnect Frontend Environment Configuration Example
# Copy this file to .env for local development:
#   cp .env.example .env

# Backend API base URL
# Local HTTP development:  http://localhost:5116/api
# Local HTTPS development: https://localhost:7194/api
# Production deployment:   https://your-api.up.railway.app/api
VITE_API_BASE_URL=http://localhost:5116/api

# Note: All variables exposed to the client bundle must be prefixed with VITE_.
# Never store secrets, private keys, or credentials in client-side .env files.
